# FiveM Server Configuration Example
# Copy to .env locally; never commit the real values.
# Put the real Cfx.re registration key in server-data/server_license.cfg
# on the host only; never paste it into GitHub or chat.
FIVEM_LICENSE_KEY=replace_me_locally
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=fluxrp
MYSQL_USER=fluxrp
MYSQL_PASSWORD=replace_me_locally
SERVER_PORT=30120
TXADMIN_PORT=40120
# Set to 0 for an internet server; 1 is LAN-only.
SV_LAN=0
